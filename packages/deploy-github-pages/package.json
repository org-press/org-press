{
  "name": "@org-press/deploy-github-pages",
  "version": "0.9.12",
  "description": "GitHub Pages deploy adapter for org-press",
  "license": "GPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ci": "vitest --run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@org-press/deploy": ">=0.9.0"
  },
  "devDependencies": {
    "@org-press/deploy": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "~5.7.3",
    "@types/node": "^20.0.0",
    "vitest": "^3.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://orgp.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/org-press/org-press.git"
  },
  "bugs": {
    "url": "https://github.com/org-press/org-press/issues"
  }
}
